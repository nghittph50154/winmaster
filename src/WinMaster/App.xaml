<Application x:Class="WinMaster.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WinMaster.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <converters:InstallStatusToColorConverter x:Key="StatusToColor"/>
            <converters:InstallStatusToTextConverter x:Key="StatusToText"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColor"/>
            <converters:CountToSelectedTextConverter x:Key="CountToSelectedText"/>
            <converters:ActiveMenuToBrushConverter x:Key="ActiveMenuToBrush"/>

            <!-- Global typography -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
