<UserControl x:Class="WinMaster.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinMaster.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDeepBrush}"
             d:DataContext="{d:DesignInstance vm:InstallViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- Search + toolbar -->
            <RowDefinition Height="*"/>       <!-- Category + cards scrollable (Full Width) -->
            <RowDefinition Height="Auto"/>    <!-- WinUtil-style Progress & Status bar -->
            <RowDefinition Height="Auto"/>    <!-- Bottom action bar -->
        </Grid.RowDefinitions>

        <!-- Search bar area -->
        <Border Grid.Row="0"
                Margin="24,20,24,12"
                Background="{StaticResource SurfaceElevatedBrush}"
                CornerRadius="10"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchBoxStyle}"
                         Height="44"
                         MaxLength="50"
                         BorderThickness="0"
                         Background="Transparent"/>
            </Grid>
        </Border>

        <!-- Scrollable category + card grid (Full Width) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="24,0,24,0">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
                            <Border Margin="0,0,0,28"
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <!-- Category header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,16">
                                        <Border Width="4" Height="18" CornerRadius="2"
                                                Background="{StaticResource AccentPrimaryBrush}"
                                                Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- App cards grid -->
                                    <ItemsControl ItemsSource="{Binding Apps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ApplicationCardViewModel}">
                                                <Border Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                    <!-- APPLICATION CARD -->
                                                    <Border x:Name="card"
                                                            Width="138" Height="152"
                                                            Margin="0,0,16,16"
                                                            CornerRadius="12"
                                                            Cursor="Hand"
                                                            BorderThickness="1.5"
                                                            MouseLeftButtonUp="Card_Click">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="#1A1A2E"/>
                                                        </Border.Background>
                                                        <Border.BorderBrush>
                                                            <SolidColorBrush x:Name="cardBorder" Color="#2E2E50"/>
                                                        </Border.BorderBrush>

                                                        <Grid>
                                                            <!-- Checkbox overlay (top-right) -->
                                                            <CheckBox x:Name="appCheckBox"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Style="{StaticResource CardCheckBoxStyle}"
                                                                      HorizontalAlignment="Right"
                                                                      VerticalAlignment="Top"
                                                                      Margin="0,10,10,0"
                                                                      Panel.ZIndex="10"/>

                                                            <!-- Status indicator dot (top-left, shows during install) -->
                                                            <Ellipse Width="8" Height="8"
                                                                     HorizontalAlignment="Left"
                                                                     VerticalAlignment="Top"
                                                                     Margin="10,12,0,0"
                                                                     Fill="{Binding InstallStatus, Converter={StaticResource StatusToColor}}"
                                                                     Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                                                            <!-- Card content -->
                                                            <StackPanel VerticalAlignment="Center"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="12,14,12,10">

                                                                <!-- App icon (Image or Emoji fallback) -->
                                                                <Border Width="48" Height="48"
                                                                        CornerRadius="12"
                                                                        Margin="0,0,0,10"
                                                                        HorizontalAlignment="Center"
                                                                        ClipToBounds="True">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="#1E1E38" Offset="0"/>
                                                                            <GradientStop Color="#252545" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <Grid>
                                                                        <!-- Image icon if downloaded -->
                                                                        <Image Source="{Binding IconPath}"
                                                                               Width="32" Height="32"
                                                                               Stretch="Uniform"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding HasImageIcon, Converter={StaticResource BoolToVisibility}}"/>

                                                                        <!-- Fallback emoji icon -->
                                                                        <TextBlock x:Name="appIcon"
                                                                                   Text="{Binding IconEmoji}"
                                                                                   FontSize="24"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   TextAlignment="Center"
                                                                                   Visibility="{Binding HasImageIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- App name -->
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="114"
                                                                           LineHeight="16"
                                                                           Padding="4,0"/>

                                                                <!-- Status label -->
                                                                <TextBlock Text="{Binding InstallStatus, Converter={StaticResource StatusToText}}"
                                                                           FontSize="10"
                                                                           Foreground="{Binding InstallStatus, Converter={StaticResource StatusToColor}}"
                                                                           TextAlignment="Center"
                                                                           Margin="0,4,0,0"
                                                                           Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Hover/Selected triggers -->
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="MouseEnter">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetName="cardBorder"
                                                                                        Storyboard.TargetProperty="Color"
                                                                                        To="#6C63FF" Duration="0:0:0.15"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                            <EventTrigger RoutedEvent="MouseLeave">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetName="cardBorder"
                                                                                        Storyboard.TargetProperty="Color"
                                                                                        To="#2E2E50" Duration="0:0:0.15"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Border.Triggers>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        <!-- ═══ WINUTIL-STYLE BOTTOM PROGRESS & STATUS BAR ═══════════════ -->
        <Border Grid.Row="2"
                Visibility="{Binding IsProgressOrSummaryVisible, Converter={StaticResource BoolToVisibility}}"
                Background="{StaticResource SurfaceElevatedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Current Status Message -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusIcon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentStatusMessage}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Progress percentage -->
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding ProgressPercentText}"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <!-- Dismiss Button when completed -->
                <Button Grid.Row="0" Grid.Column="2"
                        Content="✕"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="8,2" FontSize="11"
                        Command="{Binding DismissSummaryCommand}"
                        Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Đóng thông báo kết quả"/>

                <!-- Sleek Progress Bar -->
                <ProgressBar Grid.Row="2" Grid.ColumnSpan="3"
                             Height="6"
                             Value="{Binding OverallProgress}"
                             Maximum="100"
                             Style="{StaticResource AccentProgressBarStyle}"/>

                <!-- Session summary details (when completed) -->
                <TextBlock Grid.Row="3" Grid.ColumnSpan="3"
                           Text="{Binding SessionSummaryText}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Margin="0,8,0,0"
                           Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- ═══ BOTTOM ACTION BAR ═══════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Chế độ cài đặt & Tải file (Single Selection) -->
                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            CornerRadius="8"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="14,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="⚙" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Chế độ thực thi:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="⚡ Cài tự động"
                                             IsChecked="{Binding IsSilentMode, Mode=TwoWay}"
                                             GroupName="InstallModeGroup"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             Margin="0,0,18,0"
                                             ToolTip="Cài đặt hoàn toàn tự động, im lặng trong nền (không hiện cửa sổ wizard)."/>

                                <RadioButton Content="🖥 Hiện Setup"
                                             IsChecked="{Binding IsInteractiveMode, Mode=TwoWay}"
                                             GroupName="InstallModeGroup"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             Margin="0,0,18,0"
                                             ToolTip="Mở giao diện cài đặt chính thức của phần mềm để tự bấm Next và tùy chọn tính năng."/>

                                <RadioButton Content="💾 Chỉ tải file"
                                             IsChecked="{Binding IsDownloadOnlyMode, Mode=TwoWay}"
                                             GroupName="InstallModeGroup"
                                             Foreground="#38BDF8"
                                             FontSize="12"
                                             FontWeight="Bold"
                                             ToolTip="Chỉ tải file cài đặt .exe / .zip về thư mục chỉ định, không cài vào hệ thống."/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Vị trí lưu file exe / cài đặt -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="📁" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Vị trí lưu file exe:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource SurfaceElevatedBrush}"
                                CornerRadius="6"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="10,5"
                                Margin="0,0,8,0">
                            <TextBox Text="{Binding CustomInstallPath, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     ToolTip="Thư mục lưu file cài đặt .exe khi chọn 'Chỉ tải file không cài đặt' (Mặc định: Downloads). Bấm Browse... để đổi."/>
                        </Border>

                        <Button Grid.Column="2"
                                Content="📁 Browse..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseCustomInstallPathCommand}"
                                Margin="0,0,6,0"
                                Padding="12,5"/>

                        <Button Grid.Column="3"
                                Content="Reset"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearCustomInstallPathCommand}"
                                Padding="10,5"
                                ToolTip="Reset về thư mục Downloads mặc định"/>
                    </Grid>

                    <!-- Row 4: Action Controls & RUN Button -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selection controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Select All"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SelectAllCommand}"/>
                            <Button Content="Clear"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearSelectionCommand}"/>
                            <Button Content="💻 PowerShell Log"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenPowerShellLogCommand}"
                                    Margin="8,0,0,0"
                                    ToolTip="Mở cửa sổ PowerShell xem log chi tiết thời gian thực"/>
                        </StackPanel>

                        <!-- Selected count -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedCountText}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Content="{Binding RunButtonText}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="13"
                                Padding="28,10"
                                Command="{Binding RunCommand}"
                                IsEnabled="{Binding CanRun}"/>
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</UserControl>


