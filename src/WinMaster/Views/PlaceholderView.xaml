<UserControl x:Class="WinMaster.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinMaster.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDeepBrush}"
             d:DataContext="{d:DesignInstance vm:PlaceholderViewModel}">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">

            <!-- Coming soon icon -->
            <Border Width="80" Height="80" CornerRadius="20"
                    HorizontalAlignment="Center" Margin="0,0,0,28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E1E38" Offset="0"/>
                        <GradientStop Color="#252545" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="🚧"
                           FontSize="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Title -->
            <TextBlock Text="{Binding MenuTitle}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextAlignment="Center"
                       Margin="0,0,0,12"/>

            <!-- "Coming in vX.X" badge -->
            <Border HorizontalAlignment="Center"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    CornerRadius="20" Padding="16,6" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Coming in"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding PlannedVersion}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Description -->
            <TextBlock Text="{Binding ComingSoonDescription}"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="22"/>

            <!-- Gradient divider -->
            <Border Height="1" Margin="60,32,60,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#2E2E50" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <TextBlock Text="WinMaster is being actively developed."
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

