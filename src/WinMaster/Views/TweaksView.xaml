<UserControl x:Class="WinMaster.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinMaster.ViewModels"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDeepBrush}"
             d:DataContext="{d:DesignInstance vm:TweaksViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Custom Radio Card Style -->
        <Style x:Key="RadioCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="BorderBrush" Value="#2E2E50"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24,18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <!-- ═══ Tweaks Options & Actions (Full Width - Clean layout like Install View) ════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- Section Title -->
            <RowDefinition Height="*"/>        <!-- Options list -->
            <RowDefinition Height="Auto"/>    <!-- Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- Header Title -->
        <StackPanel Grid.Row="0" Margin="28,24,28,16">
            <TextBlock Text="⚙ TWEAKS &amp; ACTIVATION"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Chọn công cụ hoặc script tối ưu hệ thống và bấm RUN để thực thi tự động với quyền Administrator."
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Radio Options List -->
        <ScrollViewer Grid.Row="1" Margin="28,0,28,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TweakOptionViewModel}">
                        <Border x:Name="cardBorder" Style="{StaticResource RadioCardStyle}">
                            <Grid MouseLeftButtonDown="OptionCard_Click">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>   <!-- Radio Indicator -->
                                    <ColumnDefinition Width="*"/>      <!-- Text Content -->
                                </Grid.ColumnDefinitions>

                                <!-- Radio Outer Circle -->
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                        BorderThickness="2" VerticalAlignment="Top" Margin="0,2,16,0"
                                        x:Name="radioCircle">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#4E4E70"/>
                                    </Border.BorderBrush>
                                    <!-- Inner Selected Dot -->
                                    <Ellipse x:Name="radioDot" Width="10" Height="10" Fill="{StaticResource AccentPrimaryBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>

                                <!-- Content Info -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,4,0,8" TextWrapping="Wrap"/>

                                    <!-- Code block & Copy button -->
                                    <Border Background="#121220" CornerRadius="8" Padding="14,10" BorderBrush="#2A2A48" BorderThickness="1"
                                            Visibility="{Binding ShowCode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CommandText}"
                                                       FontFamily="Consolas" FontSize="12" Foreground="#00E676"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Margin="0,0,12,0"/>
                                            <Button Grid.Column="1"
                                                    Command="{Binding CopyCommand}"
                                                    ToolTip="Sao chép câu lệnh"
                                                    Padding="12,6"
                                                    Background="#2E2E50" Foreground="#FFFFFF"
                                                    BorderThickness="0"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📋 " FontSize="11"/>
                                                    <TextBlock Text="Copy" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="#222240"/>
                                <Setter TargetName="radioCircle" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="radioDot" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="🛡 Đã tích hợp thực thi tự động qua PowerShell / CMD với quyền Administrator"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="💻 PowerShell Log"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenPowerShellLogCommand}"
                            Padding="14,6"
                            FontSize="12"
                            ToolTip="Mở cửa sổ PowerShell xem log chi tiết thời gian thực"/>
                </StackPanel>

                <!-- RUN Button -->
                <Button Content="▶  RUN"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right"
                        FontSize="13" Padding="40,10"
                        Command="{Binding RunCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
