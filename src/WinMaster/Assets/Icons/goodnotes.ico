  function getDownloadLink() {
    const ua = navigator.userAgent || navigator.vendor || window.opera;

    if (/android/i.test(ua)) {
      return 'https://play.google.com/store/apps/details?id=com.goodnotes.android.app';
    }

    if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) {
      return 'https://apps.apple.com/us/app/goodnotes-ai-notes-docs-pdf/id1444383602?platform=mac';
    }

    if (/Macintosh|Mac OS X/.test(ua)) {
      return 'https://apps.apple.com/us/app/goodnotes-ai-notes-docs-pdf/id1444383602?platform=mac';
    }

    if (/Windows/.test(ua)) {
      return 'https://get.microsoft.com/installer/download/9N92MC09DB30?cid=goodnotes_web_uniqueidhere';
    }

    return '#'; 
  }

  document.addEventListener('DOMContentLoaded', function () {
    const btn = document.querySelector('.footer .download-btn'); 

    if (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        const link = getDownloadLink();
        window.location.href = link;
      });
    }
  });
</script></div></div></div></section><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6978a92a56d24460cdf7442e" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6978a92a56d24460cdf7442e/js/goodnotes-official.schunk.36b8fb49256177c8.js" type="text/javascript" integrity="sha384-4abIlA5/v7XaW1HMXKBgnUuhnjBYJ/Z9C1OSg4OhmVw9O3QeHJ/qJqFBERCDPv7G" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6978a92a56d24460cdf7442e/js/goodnotes-official.schunk.d82841363d795ab1.js" type="text/javascript" integrity="sha384-hEiKGJefhw/K5dW0eGzRHemlFLKTKoQ8wfeKA7uMEoDT70hZkANZURpHrlRvWUMm" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6978a92a56d24460cdf7442e/js/goodnotes-official.d6f657e3.ef63fbc4c795631d.js" type="text/javascript" integrity="sha384-2ZVKlJw03jyI6JRZHQHnYLO4Q2vcdzPgndxAbKN4bmDhgszIksQyfjjhHNMFZHup" crossorigin="anonymous"></script><!-- HubSpot Tracking Code -->
<script type="text/javascript" id="hs-script-loader" async defer src="https://js-eu1.hs-scripts.com/26813687.js"></script>

<style>
  /* Hubspot form Variables Style */
  :root {
    --hsf-global__font-family: Roobert, Arial, sans-serif;
    --hsf-background__padding: 40px;
    --hsf-global__font-size: 16px;
    --hsf-row__horizontal-spacing: 32px;

    --hsf-field-label__font-size: 18px;

    --hsf-field-input__padding: 12px 20px;
    --hsf-field-input__border-radius: 10px;
    --hsf-field-input__border-color: #ececec;

    --hsf-button__padding: 12px 32px;
    --hsf-button__color: #000000;
    --hsf-button__background-color: #57d2ee;
    --hsf-button--hover__background-color: #06a9cf;

    --hsf-erroralert__font-size: 13px;
  }

  @media (max-width: 767px) {
    .hsfc-FormWrapper {
      --hsf-background__padding: 16px;
    }
  }
</style>

<script>
  (function ($) {
    // Override Smooth scroll natively by webflow
    $(document).ready(function () {
      setTimeout(function () {
        var rootTag = 'body';
        var headerSelector = 'header, ' + rootTag + ' > .header, ' + rootTag + ' > .w-nav:not([data-no-scroll])';
        var localHrefSelector = 'a[href*="#"]:not(.w-tab-link):not(a[href="#"])';

        $(document).off('click.wf-scroll');
        $(document).on('click.wf-scroll', localHrefSelector, function (evt) {
          var target = evt.currentTarget;
          if (window.Webflow && window.Webflow.env('design')) return;
          // Build a temp link to resolve the href
          var tempLink = document.createElement('a');
          var href = target.getAttribute('href');
          tempLink.href = href;
          // Only process same-page hash links
          var validHash = /^#[a-zA-Z0-9][\w:.-]*$/;
          var isSamePage = validHash.test(tempLink.hash) && tempLink.host + tempLink.pathname === window.location.host + window.location.pathname;
          if (!isSamePage || tempLink.hash === '') return;
          var $el = $(tempLink.hash);
          if (!$el.length) return;
          evt.preventDefault();
          evt.stopPropagation();
          // --- Custom offset calculation ---
          var $header = $(headerSelector);
          var pos = $header.css('position');
          var offsetY = pos === 'fixed' || pos === 'sticky' ? $header.outerHeight() : 0;
          var end = $el.offset().top - offsetY;

          if ($el.data('scroll') === 'mid') {
            var available = $(window).height() - offsetY;
            var elHeight = $el.outerHeight();
            if (elHeight < available) {
              end -= Math.round((available - elHeight) / 2);
            }
          }
          // -------------------------------------------
          // Smooth scroll to calculated position
          $('html, body').animate({ scrollTop: end }, 600, 'swing');
        });
      }, 100); // Small delay to ensure Webflow binds first so we can unbind it
    });
  })(jQuery);
</script>

<!-- UTM sessionStorage capture + HubSpot form hydrate | Added by Rex on 2026-09-17 -->
<script>
/**
 * Capture UTMs from the landing URL into sessionStorage,
 * then set HubSpot hidden fields via HubSpotFormsV4 API (no page reload).
 *
 * Uses official setFieldValue so React/form state is updated (DOM-only writes are unreliable).
 * Remove this whole block to disable.
 */
(function () {
  var KEY = "gn_utm_attribution";
  var KEYS = [
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_term",
    "utm_content"
  ];
  var loggedOk = false;

  function log() {
    if (!window.console) return;
    var args = Array.prototype.slice.call(arguments);
    args.unshift("[gn-utm]");
    console.log.apply(console, args);
  }

  function getStored() {
    try {
      return JSON.parse(sessionStorage.getItem(KEY) || "null");
    } catch (e) {
      return null;
    }
  }

  // 1) Capture from URL → sessionStorage
  var params = new URLSearchParams(location.search);
  var incoming = {};
  var found = false;
  KEYS.forEach(function (k) {
    var v = params.get(k);
    if (v) {
      incoming[k] = v;
      found = true;
    }
  });
  if (found) {
    sessionStorage.setItem(KEY, JSON.stringify(incoming));
    log("OK CAPTURE", incoming);
  }

  function propName(key) {
    return "0-1/" + key;
  }

  function applyToFormInstance(form, data, reason) {
    if (!form || !data || typeof form.setFieldValue !== "function") return 0;
    var n = 0;
    KEYS.forEach(function (k) {
      if (!data[k]) return;
      try {
        form.setFieldValue(propName(k), data[k]);
        n += 1;
      } catch (e) {}
    });
    if (n > 0 && (reason === "submit" || !loggedOk)) {
      log("OK SET via HubSpotFormsV4 (" + reason + ")", data);
      loggedOk = true;
    }
    return n;
  }

  // 2) Set fields through HubSpot V4 API (updates real form state)
  function hydrate(reason) {
    var data = getStored();
    if (!data) return 0;

    var total = 0;
    var api = window.HubSpotFormsV4;

    if (api) {
      if (typeof api.getForms === "function") {
        var forms = api.getForms() || [];
        for (var i = 0; i < forms.length; i++) {
          total += applyToFormInstance(forms[i], data, reason);
        }
      }
    }

    if (reason === "submit" && total === 0) {
      log("FAIL SET on submit — HubSpotFormsV4 form not available", data);
    }
    return total;
  }

  // Official ready event
  window.addEventListener("hs-form-event:on-ready", function (event) {
    var data = getStored();
    if (!data) return;
    var api = window.HubSpotFormsV4;
    if (api && typeof api.getFormFromEvent === "function") {
      try {
        var form = api.getFormFromEvent(event);
        applyToFormInstance(form, data, "on-ready");
        // Prefill may run later — set again
        setTimeout(function () {
          applyToFormInstance(form, data, "on-ready+300ms");
        }, 300);
        setTimeout(function () {
          applyToFormInstance(form, data, "on-ready+1000ms");
        }, 1000);
        return;
      } catch (e) {}
    }
    hydrate("on-ready-fallback");
  });

  // Legacy callback (some embeds still use it)
  window.addEventListener("message", function (e) {
    if (!e.data || e.data.type !== "hsFormCallback") return;
    if (e.data.eventName === "onFormReady") {
      setTimeout(function () {
        hydrate("hsFormCallback");
      }, 50);
      setTimeout(function () {
        hydrate("hsFormCallback+300ms");
      }, 300);
    }
  });

  // Re-apply right before submit
  document.addEventListener(
    "click",
    function (e) {
      var btn =
        e.target &&
        e.target.closest &&
        e.target.closest('button[type="submit"], .hsfc-Button, input[type="submit"]');
      if (!btn) return;
      hydrate("submit");
    },
    true
  );

  document.addEventListener(
    "submit",
    function () {
      hydrate("submit");
    },
    true
  );

  // In case API appears after our script
  var tries = 0;
  var poll = setInterval(function () {
    tries += 1;
    if (window.HubSpotFormsV4 || tries > 40) {
      clearInterval(poll);
      hydrate("poll");
    }
  }, 250);
})();
</script>

<!-- End of UTM sessionStorage capture + HubSpot form hydrate --></body></html>