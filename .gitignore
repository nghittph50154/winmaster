# WinMaster .gitignore

# Build outputs
bin/
obj/
*.user
*.suo
.vs/
.idea/

# NuGet packages
*.nupkg
packages/

# dotnet publish output
publish/

# Sources directory — fixed source installers
!sources/


# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Log files
*.log

# Temporary files
*.tmp
*.temp

# Environment files
.env
.env.local

# Visual Studio crash reports
*.dmp
